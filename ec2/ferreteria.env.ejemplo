# Copiar como ferreteria.env (en la EC2) y completar. ferreteria.env no se sube a git.
# Endpoint de RDS: consola de AWS -> RDS -> Databases -> tu base -> Connectivity & security
DB_HOST=ferreteria.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=ferreteria
DB_PASSWORD=Ferreteria123!
PRODUCTOS_URL=http://localhost:8082

# Clave para firmar los tokens JWT. Debe ser la misma en los 5 servicios (aqui ya lo es) y tener al menos 32 caracteres.
# Generar una propia con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres

# Origen del frontend permitido por CORS (usuarios y productos). Descomentar si el frontend no corre en localhost:5173
# APP_CORS_ORIGENES=http://<IP-o-dominio-del-frontend>
